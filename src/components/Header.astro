---
import { url, esActiva } from "../lib/rutas.js";
import { LLAVE_SESION, ROLES } from "../lib/sesion.js";

const actual = Astro.url.pathname;
const enlaces = [
  { href: "/", texto: "Inicio" },
  { href: "/integrantes", texto: "Integrantes" },
  { href: "/agenda", texto: "Agenda de la Red" },
  { href: "/noticias", texto: "Noticias" },
  { href: "/startups", texto: "Startups" },
];
---

<header class="cabecera">
  <div class="envoltorio cabecera__caja">
    <a class="cabecera__marca" href={url("/")}>
      <img src={url("/img/logo-red-hubs.png")} alt="Red Chilena de Hubs Municipales" width="601" height="121" />
    </a>

    <input class="cabecera__interruptor" type="checkbox" id="menu" />
    <label class="cabecera__hamburguesa" for="menu">
      <span></span><span></span><span></span>
      <span class="visualmente-oculto">Abrir menú</span>
    </label>

    <nav class="cabecera__nav" aria-label="Principal">
      {
        enlaces.map((enlace) => (
          <a
            href={url(enlace.href)}
            class:list={["cabecera__enlace", { "es-activo": esActiva(actual, enlace.href) }]}
            aria-current={esActiva(actual, enlace.href) ? "page" : undefined}
          >
            {enlace.texto}
          </a>
        ))
      }
      <a
        href={url("/buenas-practicas")}
        class:list={[
          "cabecera__enlace",
          "cabecera__reservado",
          { "es-activo": esActiva(actual, "/buenas-practicas") },
        ]}
        aria-current={esActiva(actual, "/buenas-practicas") ? "page" : undefined}
        data-sesion-dentro
        hidden
      >
        Buenas prácticas
      </a>

      <a
        href={url("/cuentas")}
        class:list={[
          "cabecera__enlace",
          "cabecera__reservado",
          { "es-activo": esActiva(actual, "/cuentas") },
        ]}
        aria-current={esActiva(actual, "/cuentas") ? "page" : undefined}
        data-sesion-superadmin
        hidden
      >
        Cuentas
      </a>

      <a class="boton boton--magenta cabecera__acceso" href={url("/acceso")} data-sesion-fuera>
        Acceso miembros
      </a>

      <div class="cabecera__cuenta" data-sesion-dentro hidden>
        <span class="cabecera__rol" data-sesion-rol></span>
        <span class="cabecera__organizacion" data-sesion-organizacion></span>
        <button class="cabecera__salir" type="button" data-sesion-salir>Salir</button>
      </div>
    </nav>
  </div>
</header>

<script is:inline define:vars={{ LLAVE_SESION, ROLES }}>
  (() => {
    let sesion = null;
    try {
      const bruto = sessionStorage.getItem(LLAVE_SESION);
      const leida = bruto ? JSON.parse(bruto) : null;
      if (leida && ROLES[leida.rol]) sesion = leida;
    } catch (error) {
      sesion = null;
    }

    document.querySelectorAll("[data-sesion-fuera]").forEach((nodo) => {
      nodo.hidden = Boolean(sesion);
    });
    document.querySelectorAll("[data-sesion-dentro]").forEach((nodo) => {
      nodo.hidden = !sesion;
    });
    document.querySelectorAll("[data-sesion-superadmin]").forEach((nodo) => {
      nodo.hidden = !sesion || sesion.rol !== "superadmin";
    });

    if (!sesion) return;

    const rol = ROLES[sesion.rol];
    const rotulo = document.querySelector("[data-sesion-rol]");
    rotulo.textContent = rol.etiqueta;
    rotulo.style.setProperty("--color", rol.color);
    document.querySelector("[data-sesion-organizacion]").textContent = sesion.organizacion;
  })();
</script>

<script>
  import { cerrarSesion } from "../lib/sesion.js";
  import { url } from "../lib/rutas.js";

  document.querySelector("[data-sesion-salir]")?.addEventListener("click", () => {
    cerrarSesion();
    window.location.href = url("/");
  });
</script>

<style>
  .cabecera {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--papel);
    border-bottom: var(--linea);
  }

  .cabecera__caja {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    min-height: 4.75rem;
  }

  .cabecera__marca img {
    height: 2.1rem;
    width: auto;
  }

  .cabecera__nav {
    display: flex;
    align-items: center;
    gap: 1.75rem;
  }

  .cabecera__enlace {
    text-decoration: none;
    font-weight: 600;
    font-size: 0.98rem;
    padding-block: 0.35rem;
    border-bottom: 3px solid transparent;
  }

  .cabecera__enlace:hover {
    border-bottom-color: var(--magenta);
  }

  .cabecera__enlace.es-activo {
    border-bottom-color: var(--tinta);
  }

  .cabecera__acceso {
    padding: 0.6rem 1.1rem;
    font-size: 0.82rem;
  }

  .cabecera__nav [hidden] {
    display: none;
  }

  .cabecera__reservado {
    border-bottom-color: var(--turquesa);
  }

  .cabecera__cuenta {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    border: var(--linea);
    box-shadow: var(--sombra-corta);
    background: var(--papel);
    padding: 0.35rem 0.35rem 0.35rem 0.55rem;
  }

  .cabecera__rol {
    font-family: var(--display);
    font-size: 0.6rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    background: var(--color, var(--amarillo));
    border: 1.5px solid var(--tinta);
    padding: 0.2rem 0.45rem;
  }

  .cabecera__organizacion {
    font-size: 0.82rem;
    font-weight: 600;
    max-width: 14ch;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .cabecera__salir {
    font: inherit;
    font-family: var(--display);
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    cursor: pointer;
    border: 1.5px solid var(--tinta);
    background: var(--tinta);
    color: var(--papel);
    padding: 0.35rem 0.7rem;
  }

  .cabecera__salir:hover {
    background: var(--magenta);
    color: var(--tinta);
  }

  .cabecera__interruptor,
  .cabecera__hamburguesa {
    display: none;
  }

  @media (max-width: 900px) {
    .cabecera__hamburguesa {
      display: grid;
      gap: 5px;
      cursor: pointer;
      padding: 0.5rem;
    }

    .cabecera__hamburguesa span:not(.visualmente-oculto) {
      display: block;
      width: 26px;
      height: 3px;
      background: var(--tinta);
    }

    .cabecera__nav {
      display: none;
      position: absolute;
      inset: 100% 0 auto 0;
      flex-direction: column;
      align-items: flex-start;
      gap: 0.25rem;
      padding: 1.25rem 1.5rem 1.75rem;
      background: var(--papel);
      border-bottom: var(--linea);
    }

    .cabecera__interruptor:checked ~ .cabecera__nav {
      display: flex;
    }

    .cabecera__enlace {
      font-size: 1.1rem;
      padding-block: 0.55rem;
    }

    .cabecera__acceso {
      margin-top: 0.75rem;
    }

    .cabecera__cuenta {
      margin-top: 0.9rem;
    }

    .cabecera__organizacion {
      max-width: 22ch;
    }
  }
</style>
