---
import { url } from "../lib/rutas.js";

const anio = 2026;
---

<footer class="pie">
  <div class="envoltorio pie__caja">
    <div class="pie__marca">
      <img src={url("/img/logo-red-hubs-blanco.png")} alt="Red Chilena de Hubs Municipales" width="601" height="121" />
      <p>Coordinada por HUB Providencia como Secretaría Ejecutiva.</p>
    </div>

    <nav class="pie__nav" aria-label="Pie de página">
      <a href={url("/integrantes")}>Integrantes</a>
      <a href={url("/agenda")}>Agenda de la Red</a>
      <a href={url("/startups")}>Startups</a>
      <a href={url("/acceso")}>Acceso miembros</a>
      <a href="https://providencia.cl/provi/comunidad/hub-providencia/red-de-hubs/red-chilena-hubs-municipales" rel="noopener">
        HUB Providencia
      </a>
    </nav>

    <p class="pie__nota">
      Mapa construido sobre geoBoundaries gbOpen CHL ADM0, de dominio público, derivado de Natural Earth.
      Los datos de integrantes, agenda y startups provienen de la base de la Red. {anio}.
    </p>
  </div>
</footer>

<style>
  .pie {
    background: var(--tinta);
    color: var(--papel);
    padding-block: 3.5rem 2.5rem;
    margin-top: 0;
  }

  .pie__caja {
    display: grid;
    gap: 2.5rem;
  }

  .pie__marca img {
    height: 2.4rem;
    width: auto;
    margin-bottom: 1rem;
  }

  .pie__marca p {
    font-size: 1.05rem;
    max-width: 34ch;
    margin: 0;
  }

  .pie__nav {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    padding-block: 1.75rem;
    border-block: 1px solid rgba(255, 255, 255, 0.22);
  }

  .pie__nav a {
    text-decoration: none;
    font-weight: 600;
    border-bottom: 2px solid transparent;
  }

  .pie__nav a:hover {
    border-bottom-color: var(--magenta);
  }

  .pie__nota {
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.62);
    max-width: 70ch;
    margin: 0;
  }
</style>
