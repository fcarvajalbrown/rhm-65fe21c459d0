---
import Base from "../layouts/Base.astro";
import miembros from "../data/miembros.json";
import { eventos, proximas, anteriores } from "../lib/agenda.js";
import { colorCategoria } from "../lib/categorias.js";

const categorias = [...new Set(eventos.map((e) => e.categoria).filter(Boolean))].sort((a, b) =>
  a.localeCompare(b, "es")
);
const modalidades = [...new Set(eventos.map((e) => e.modalidad).filter(Boolean))].sort((a, b) =>
  a.localeCompare(b, "es")
);
const organizadores = [
  ...new Set([
    ...miembros.map((m) => m.organizacion),
    ...eventos.map((e) => e.organizador).filter((valor) => valor && valor !== "-"),
  ]),
].sort((a, b) => a.localeCompare(b, "es"));
---

<Base
  titulo="Agenda de la Red"
  descripcion="Eventos, capacitaciones, reuniones y mesas territoriales de la Red Chilena de Hubs Municipales."
>
  <section class="encabezado">
    <div class="envoltorio">
      <p class="rotulo">Agenda de la Red</p>
      <h1><span data-conteo="proximas">{proximas.length}</span> actividades próximas</h1>
      <p class="bajada">
        <span data-conteo="anteriores">{anteriores.length}</span> actividades anteriores desde la
        reunión anual de mayo. La agenda recoge lo que organiza cada integrante y lo abre al resto de
        la Red.
      </p>
    </div>
  </section>

  <section class="seccion">
    <div class="envoltorio">
      <div class="barra">
        <form class="filtros" id="filtros">
          <label class="filtro">
            <span class="visualmente-oculto">Categoría</span>
            <select id="categoria">
              <option value="">Todas las categorías</option>
              {categorias.map((categoria) => <option value={categoria}>{categoria}</option>)}
            </select>
          </label>
          <label class="filtro">
            <span class="visualmente-oculto">Modalidad</span>
            <select id="modalidad">
              <option value="">Toda modalidad</option>
              {modalidades.map((modalidad) => <option value={modalidad}>{modalidad}</option>)}
            </select>
          </label>
        </form>

        <button class="boton boton--magenta nueva" type="button" id="nueva" hidden>
          Nueva actividad
        </button>
      </div>

      <p class="aviso" id="aviso" hidden>
        Prototipo: lo que crees o borres aquí queda solo en este navegador y no se publica para el
        resto de la Red.
      </p>

      <div class="bloque">
        <h2 class="bloque__titulo">Próximas actividades</h2>
        <ul class="lista" id="lista-proximas">
          {
            proximas.map((evento) => (
              <li
                class="evento"
                data-id={evento.id}
                data-fecha={evento.fecha}
                data-organizador={evento.organizador}
                data-categoria={evento.categoria}
                data-modalidad={evento.modalidad}
                style={`--color: ${colorCategoria(evento.categoria)}`}
              >
                <div class="evento__fecha">
                  <span class="evento__dia">{evento.dia}</span>
                  <span class="evento__mes">{evento.mes}</span>
                  <span class="evento__anio">{evento.anio}</span>
                </div>
                <div class="evento__cuerpo">
                  <h3>{evento.titulo}</h3>
                  <p class="evento__meta">
                    {[evento.categoria, evento.modalidad, evento.horario, evento.organizador]
                      .filter(Boolean)
                      .join(" · ")}
                  </p>
                  {evento.lugar && <p class="evento__lugar">{evento.lugar}</p>}
                  {evento.conQuien && <p class="evento__quien">Con: {evento.conQuien}</p>}
                  {evento.notas && <p class="evento__notas">{evento.notas}</p>}
                </div>
                <button class="evento__borrar" type="button" data-borrar hidden>
                  <span class="visualmente-oculto">Borrar {evento.titulo}</span>
                  <span aria-hidden="true">×</span>
                </button>
              </li>
            ))
          }
        </ul>
        <p class="vacio" data-vacio="proximas" hidden>No hay actividades próximas con ese filtro.</p>
      </div>

      <div class="bloque">
        <h2 class="bloque__titulo bloque__titulo--tenue">Actividades anteriores</h2>
        <ul class="lista" id="lista-anteriores">
          {
            anteriores.map((evento) => (
              <li
                class="evento evento--pasado"
                data-id={evento.id}
                data-fecha={evento.fecha}
                data-organizador={evento.organizador}
                data-categoria={evento.categoria}
                data-modalidad={evento.modalidad}
                style={`--color: ${colorCategoria(evento.categoria)}`}
              >
                <div class="evento__fecha">
                  <span class="evento__dia">{evento.dia}</span>
                  <span class="evento__mes">{evento.mes}</span>
                  <span class="evento__anio">{evento.anio}</span>
                </div>
                <div class="evento__cuerpo">
                  <h3>
                    {evento.titulo}
                    {evento.estado !== "Realizada" && (
                      <span class="evento__estado">{evento.estado}</span>
                    )}
                  </h3>
                  <p class="evento__meta">
                    {[evento.categoria, evento.modalidad, evento.horario, evento.organizador]
                      .filter(Boolean)
                      .join(" · ")}
                  </p>
                  {evento.lugar && <p class="evento__lugar">{evento.lugar}</p>}
                </div>
                <button class="evento__borrar" type="button" data-borrar hidden>
                  <span class="visualmente-oculto">Borrar {evento.titulo}</span>
                  <span aria-hidden="true">×</span>
                </button>
              </li>
            ))
          }
        </ul>
        <p class="vacio" data-vacio="anteriores" hidden>No hay actividades anteriores con ese filtro.</p>
      </div>
    </div>
  </section>

  <template id="molde-evento">
    <li class="evento">
      <div class="evento__fecha">
        <span class="evento__dia"></span>
        <span class="evento__mes"></span>
        <span class="evento__anio"></span>
      </div>
      <div class="evento__cuerpo">
        <h3></h3>
        <p class="evento__meta"></p>
        <p class="evento__lugar" hidden></p>
        <p class="evento__quien" hidden></p>
        <p class="evento__notas" hidden></p>
      </div>
      <button class="evento__borrar" type="button" data-borrar hidden>
        <span class="visualmente-oculto">Borrar actividad</span>
        <span aria-hidden="true">×</span>
      </button>
    </li>
  </template>

  <dialog class="dialogo" id="dialogo">
    <form class="formulario" id="formulario-evento" method="dialog">
      <h2>Nueva actividad</h2>

      <label class="campo">
        <span class="campo__rotulo">Título</span>
        <input name="titulo" type="text" required maxlength="140" />
      </label>

      <div class="campo__par">
        <label class="campo">
          <span class="campo__rotulo">Fecha</span>
          <input name="fecha" type="date" required />
        </label>
        <label class="campo">
          <span class="campo__rotulo">Organiza</span>
          <select name="organizador" id="organizador">
            {organizadores.map((organizador) => <option value={organizador}>{organizador}</option>)}
          </select>
        </label>
      </div>

      <div class="campo__par">
        <label class="campo">
          <span class="campo__rotulo">Hora de inicio</span>
          <input name="horaInicio" type="time" />
        </label>
        <label class="campo">
          <span class="campo__rotulo">Hora de término</span>
          <input name="horaFin" type="time" />
        </label>
      </div>

      <div class="campo__par">
        <label class="campo">
          <span class="campo__rotulo">Categoría</span>
          <select name="categoria">
            {categorias.map((categoria) => <option value={categoria}>{categoria}</option>)}
          </select>
        </label>
        <label class="campo">
          <span class="campo__rotulo">Modalidad</span>
          <select name="modalidad">
            {modalidades.map((modalidad) => <option value={modalidad}>{modalidad}</option>)}
          </select>
        </label>
      </div>

      <label class="campo">
        <span class="campo__rotulo">Lugar</span>
        <input name="lugar" type="text" maxlength="140" />
      </label>

      <label class="campo">
        <span class="campo__rotulo">Con quién</span>
        <input name="conQuien" type="text" maxlength="140" />
      </label>

      <label class="campo">
        <span class="campo__rotulo">Notas</span>
        <textarea name="notas" rows="3" maxlength="400"></textarea>
      </label>

      <p class="formulario__acciones">
        <button class="boton boton--claro" type="button" id="cancelar">Cancelar</button>
        <button class="boton boton--magenta" type="submit">Guardar actividad</button>
      </p>
    </form>
  </dialog>
</Base>

<script>
  import { leerSesion, puede } from "../lib/sesion.js";
  import { agregados, borrados, agregar, borrar, idDeEvento, hoyLocal } from "../lib/agenda-local.js";
  import { MESES, colorCategoria } from "../lib/categorias.js";

  const sesion = leerSesion();

  const categoria = document.getElementById("categoria");
  const modalidad = document.getElementById("modalidad");
  const listas = {
    proximas: document.getElementById("lista-proximas"),
    anteriores: document.getElementById("lista-anteriores"),
  };
  const molde = document.getElementById("molde-evento");
  const dialogo = document.getElementById("dialogo");
  const formulario = document.getElementById("formulario-evento");
  const organizador = document.getElementById("organizador");
  const nueva = document.getElementById("nueva");
  const aviso = document.getElementById("aviso");

  const aplicar = () => {
    Object.entries(listas).forEach(([clave, lista]) => {
      let visibles = 0;
      lista.querySelectorAll(".evento").forEach((evento) => {
        const coincide =
          (!categoria.value || evento.dataset.categoria === categoria.value) &&
          (!modalidad.value || evento.dataset.modalidad === modalidad.value);
        evento.hidden = !coincide;
        if (coincide) visibles += 1;
      });
      document.querySelector(`[data-vacio="${clave}"]`).hidden = visibles > 0;
    });
  };

  const contar = () => {
    Object.entries(listas).forEach(([clave, lista]) => {
      document.querySelector(`[data-conteo="${clave}"]`).textContent = String(
        lista.querySelectorAll(".evento").length
      );
    });
  };

  const marcarPermisos = () => {
    document.querySelectorAll(".evento").forEach((nodo) => {
      const boton = nodo.querySelector("[data-borrar]");
      if (boton) boton.hidden = !puede(sesion, "agenda", "borrar", nodo.dataset.organizador);
    });
  };

  const rellenar = (nodo, selector, valor) => {
    const campo = nodo.querySelector(selector);
    campo.textContent = valor || "";
    campo.hidden = !valor;
  };

  const construir = (evento) => {
    const nodo = molde.content.firstElementChild.cloneNode(true);
    const [anio, mes, dia] = evento.fecha.split("-");
    nodo.dataset.id = evento.id;
    nodo.dataset.fecha = evento.fecha;
    nodo.dataset.organizador = evento.organizador || "";
    nodo.dataset.categoria = evento.categoria || "";
    nodo.dataset.modalidad = evento.modalidad || "";
    nodo.style.setProperty("--color", colorCategoria(evento.categoria));
    if (evento.fecha < hoyLocal()) nodo.classList.add("evento--pasado");
    nodo.querySelector(".evento__dia").textContent = dia;
    nodo.querySelector(".evento__mes").textContent = MESES[Number(mes) - 1];
    nodo.querySelector(".evento__anio").textContent = anio;
    nodo.querySelector("h3").textContent = evento.titulo;
    nodo.querySelector(".evento__meta").textContent = [
      evento.categoria,
      evento.modalidad,
      [evento.horaInicio, evento.horaFin].filter(Boolean).join(" a "),
      evento.organizador,
    ]
      .filter(Boolean)
      .join(" · ");
    rellenar(nodo, ".evento__lugar", evento.lugar);
    rellenar(nodo, ".evento__quien", evento.conQuien ? `Con: ${evento.conQuien}` : "");
    rellenar(nodo, ".evento__notas", evento.notas);
    nodo.querySelector(".visualmente-oculto").textContent = `Borrar ${evento.titulo}`;
    return nodo;
  };

  const insertar = (nodo) => {
    const pasado = nodo.dataset.fecha < hoyLocal();
    const lista = pasado ? listas.anteriores : listas.proximas;
    const siguiente = [...lista.querySelectorAll(".evento")].find((otro) =>
      pasado ? otro.dataset.fecha < nodo.dataset.fecha : otro.dataset.fecha > nodo.dataset.fecha
    );
    if (siguiente) lista.insertBefore(nodo, siguiente);
    else lista.append(nodo);
  };

  const restringirOrganizador = () => {
    if (!sesion || sesion.rol === "superadmin") return;
    const propia = sesion.organizacion;
    if (![...organizador.options].some((opcion) => opcion.value === propia)) {
      organizador.add(new Option(propia, propia));
    }
    [...organizador.options].forEach((opcion) => {
      if (opcion.value !== propia) opcion.remove();
    });
    organizador.value = propia;
  };

  const idsBorrados = new Set(borrados());
  document.querySelectorAll(".evento").forEach((nodo) => {
    if (idsBorrados.has(nodo.dataset.id)) nodo.remove();
  });
  agregados().forEach((evento) => insertar(construir(evento)));

  const puedeCrear = puede(sesion, "agenda", "crear");
  nueva.hidden = !puedeCrear;
  aviso.hidden = !puedeCrear;
  restringirOrganizador();
  marcarPermisos();
  contar();
  aplicar();

  [categoria, modalidad].forEach((control) => control.addEventListener("change", aplicar));
  document.getElementById("filtros").addEventListener("submit", (evento) => evento.preventDefault());

  nueva.addEventListener("click", () => dialogo.showModal());
  document.getElementById("cancelar").addEventListener("click", () => dialogo.close());

  formulario.addEventListener("submit", () => {
    if (!puede(sesion, "agenda", "crear")) return;
    const datos = new FormData(formulario);
    const fecha = String(datos.get("fecha"));
    const titulo = String(datos.get("titulo")).trim();
    const texto = (campo) => String(datos.get(campo) || "").trim() || null;
    const evento = {
      id: idDeEvento(fecha, titulo),
      organizador: texto("organizador"),
      fecha,
      horaInicio: texto("horaInicio"),
      horaFin: texto("horaFin"),
      categoria: texto("categoria"),
      titulo,
      conQuien: texto("conQuien"),
      modalidad: texto("modalidad"),
      lugar: texto("lugar"),
      notas: texto("notas"),
      estado: "Pendiente",
    };
    const repetido = document.querySelector(`.evento[data-id="${evento.id}"]`);
    if (repetido) repetido.remove();
    agregar(evento);
    insertar(construir(evento));
    marcarPermisos();
    contar();
    aplicar();
    formulario.reset();
    restringirOrganizador();
  });

  document.addEventListener("click", (clic) => {
    const boton = clic.target.closest("[data-borrar]");
    if (!boton) return;
    const nodo = boton.closest(".evento");
    if (!puede(sesion, "agenda", "borrar", nodo.dataset.organizador)) return;
    const titulo = nodo.querySelector("h3").firstChild.textContent.trim();
    if (!window.confirm(`¿Borrar la actividad "${titulo}"?`)) return;
    borrar(nodo.dataset.id);
    nodo.remove();
    contar();
    aplicar();
  });
</script>

<style>
  .encabezado {
    background: var(--lila);
    border-bottom: var(--linea);
    padding-block: clamp(2.5rem, 6vw, 4rem);
  }

  .encabezado h1 {
    font-size: clamp(2rem, 4.6vw, 3.6rem);
    margin-bottom: 1rem;
  }

  .barra {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 2.5rem;
  }

  .filtros {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .nueva {
    cursor: pointer;
  }

  .nueva[hidden] {
    display: none;
  }

  .aviso {
    border: 1.5px solid var(--tinta);
    background: var(--amarillo);
    padding: 0.7rem 0.95rem;
    font-size: 0.9rem;
    font-weight: 600;
    margin: -1.25rem 0 2.5rem;
  }

  .aviso[hidden] {
    display: none;
  }

  .filtro select {
    font: inherit;
    font-weight: 500;
    padding: 0.7rem 2.2rem 0.7rem 0.85rem;
    border: var(--linea);
    background-color: var(--papel);
    color: inherit;
    border-radius: 0;
    appearance: none;
    background-image: linear-gradient(45deg, transparent 50%, var(--tinta) 50%),
      linear-gradient(135deg, var(--tinta) 50%, transparent 50%);
    background-position: calc(100% - 18px) 52%, calc(100% - 12px) 52%;
    background-size: 6px 6px, 6px 6px;
    background-repeat: no-repeat;
  }

  .bloque + .bloque {
    margin-top: 3.5rem;
  }

  .bloque__titulo {
    font-size: clamp(1.4rem, 2.4vw, 2rem);
    padding-bottom: 0.75rem;
    border-bottom: var(--linea);
    margin-bottom: 1.5rem;
  }

  .bloque__titulo--tenue {
    color: var(--gris);
    border-bottom-color: var(--gris);
  }

  .lista {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.9rem;
  }

  .evento {
    position: relative;
    display: grid;
    grid-template-columns: 5.2rem minmax(0, 1fr);
    gap: 1.25rem;
    border: var(--linea);
    box-shadow: var(--sombra-corta);
    background: var(--papel);
    padding: 1.1rem 1.3rem;
  }

  .evento__borrar {
    position: absolute;
    top: 0.65rem;
    right: 0.65rem;
    width: 1.9rem;
    height: 1.9rem;
    display: grid;
    place-items: center;
    font-family: var(--display);
    font-size: 1.1rem;
    line-height: 1;
    cursor: pointer;
    border: 1.5px solid var(--tinta);
    background: var(--papel);
    color: var(--tinta);
    padding: 0;
  }

  .evento__borrar:hover {
    background: var(--naranja);
    color: var(--papel);
  }

  .evento__borrar[hidden] {
    display: none;
  }

  .evento:has(.evento__borrar:not([hidden])) .evento__cuerpo h3 {
    padding-right: 2.4rem;
  }

  .evento[hidden] {
    display: none;
  }

  .evento__fecha {
    display: grid;
    align-content: start;
    justify-items: center;
    padding: 0.6rem 0.3rem;
    background: var(--color);
    border: 1.5px solid var(--tinta);
  }

  .evento__dia {
    font-family: var(--display);
    font-size: 1.8rem;
    line-height: 1;
  }

  .evento__mes {
    font-family: var(--display);
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .evento__anio {
    font-size: 0.72rem;
    color: rgba(12, 12, 14, 0.7);
  }

  .evento__cuerpo h3 {
    font-size: 1.1rem;
    margin-bottom: 0.35rem;
  }

  .evento__cuerpo p {
    margin: 0 0 0.2rem;
  }

  .evento__meta {
    font-weight: 600;
    font-size: 0.88rem;
  }

  .evento__lugar,
  .evento__quien {
    font-size: 0.88rem;
    color: var(--gris);
  }

  .evento__notas {
    margin-top: 0.6rem;
    font-size: 0.9rem;
    border-left: 4px solid var(--color);
    padding-left: 0.8rem;
  }

  .evento--pasado {
    box-shadow: none;
    background: #fbfbfc;
  }

  .evento--pasado .evento__fecha {
    background: var(--papel);
    color: var(--gris);
  }

  .evento__estado {
    font-family: var(--texto);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    border: 1.5px solid var(--gris);
    color: var(--gris);
    padding: 0.1rem 0.4rem;
    margin-left: 0.5rem;
    vertical-align: middle;
  }

  .vacio {
    margin-top: 1.5rem;
    font-weight: 600;
  }

  .dialogo {
    width: min(100% - 2rem, 40rem);
    border: var(--linea);
    box-shadow: var(--sombra);
    background: var(--papel);
    color: var(--tinta);
    padding: 0;
  }

  .dialogo::backdrop {
    background: rgba(12, 12, 14, 0.55);
  }

  .formulario {
    display: grid;
    gap: 1rem;
    padding: 1.75rem;
  }

  .formulario h2 {
    font-size: clamp(1.5rem, 3vw, 2rem);
    margin-bottom: 0.25rem;
  }

  .campo {
    display: grid;
    gap: 0.3rem;
  }

  .campo__rotulo {
    font-family: var(--display);
    font-size: 0.66rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .campo__par {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .formulario input,
  .formulario select,
  .formulario textarea {
    font: inherit;
    width: 100%;
    padding: 0.6rem 0.75rem;
    border: var(--linea);
    background: var(--papel);
    color: inherit;
    border-radius: 0;
    resize: vertical;
  }

  .formulario__acciones {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin: 0.75rem 0 0;
    padding-top: 1.1rem;
    border-top: var(--linea);
  }

  .formulario__acciones .boton {
    cursor: pointer;
  }

  @media (max-width: 560px) {
    .evento {
      grid-template-columns: 4.2rem minmax(0, 1fr);
      gap: 0.9rem;
      padding: 0.9rem 1rem;
    }

    .campo__par {
      grid-template-columns: 1fr;
    }
  }
</style>
